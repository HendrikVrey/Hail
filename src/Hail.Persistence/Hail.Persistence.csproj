<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything Hail writes to disk: the log, settings.json and usage.json (history); plugin
    enablement arrives in M2. Nothing here is load-bearing (Hail.md §1: Hail owns no index),
    so deleting %LOCALAPPDATA%\Hail loses a log, your settings and which results you favour.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hail.Persistence</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hail.Core\Hail.Core.csproj" />
  </ItemGroup>

</Project>
