<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The plugin contract, and the only assembly both the host and a plugin load (Hail.md §6.2).

    Held to three rules by ArchitectureTests, because each one is what makes it usable by a
    stranger: no PackageReference, no ProjectReference, and no UI type. A plugin author must
    be able to reference this and nothing else.

    MIT, unlike the application, and it carries its own LICENSE beside this file: a plugin
    author has to compile against it, ship it in their plugin's folder and publish under any
    terms, which the application's source-available licence forbids (Hail.md §14).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hail.Sdk</RootNamespace>
    <!--
      1.0 from M2: the contract is now kept. A minor version only adds; the host loads a
      plugin built against its own major and any minor up to its own, and refuses the rest
      with a sentence (SdkCompatibility).
    -->
    <Version>1.0.0</Version>
    <!-- The XML documentation ships in the package, so a plugin author reads it in the editor. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>Hail.Sdk</PackageId>
    <Description>The plugin contract for Hail, a keyboard launcher for Windows. Reference it with ExcludeAssets="runtime": Hail supplies it when it loads a plugin.</Description>
    <PackageTags>hail;launcher;plugin;windows</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
