<Window
  x:Class="Hail.App.SearchWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Hail.App"
  Title="Hail"
  Width="680"
  SizeToContent="Height"
  WindowStyle="SingleBorderWindow"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  Topmost="True"
  WindowStartupLocation="Manual"
  Left="-32000"
  Top="-32000"
  Background="Transparent"
  UseLayoutRounding="True"
  FontFamily="{StaticResource BoxFont}">

  <!--
    A normal window frame with no caption: DWM keeps drawing the frame's shadow, its rounded
    corners and, behind the transparent client area, the transient acrylic backdrop
    (Hail.md §10.2). WindowStyle="None" would lose all three.
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome
      CaptionHeight="0"
      GlassFrameThickness="-1"
      ResizeBorderThickness="0"
      CornerRadius="0"
      UseAeroCaptionButtons="False"
      NonClientFrameEdges="None" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>

  <Border x:Name="Surface" Padding="8,4,8,8">
    <StackPanel>

      <Grid Height="56" Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
          FontFamily="{StaticResource IconFont}"
          FontSize="20"
          Text="&#xE721;"
          VerticalAlignment="Center"
          Margin="2,2,14,0"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <Grid Grid.Column="1">
          <TextBlock
            x:Name="Placeholder"
            Text="Search apps"
            FontFamily="{StaticResource BoxDisplayFont}"
            FontSize="22"
            Margin="2,0,0,0"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBox
            x:Name="SearchBox"
            Style="{StaticResource SearchBoxStyle}"
            AutomationProperties.Name="Search"
            TextChanged="SearchBox_TextChanged" />
        </Grid>
      </Grid>

      <Border
        Height="1"
        Margin="-8,0,-8,0"
        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
        Visibility="{Binding HasContent, Converter={StaticResource Visible}}" />

      <ItemsControl
        x:Name="Rows"
        Margin="0,6,0,0"
        ItemsSource="{Binding Rows}"
        Focusable="False"
        Visibility="{Binding HasRows, Converter={StaticResource Visible}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ResultRow}">
            <Border
              x:Name="Row"
              Height="48"
              CornerRadius="6"
              Background="Transparent"
              Cursor="Hand"
              MouseMove="Row_MouseMove"
              MouseLeftButtonUp="Row_MouseLeftButtonUp">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The Windows 11 selection mark: an accent pill at the row's left edge. -->
                <Border
                  x:Name="Pill"
                  Width="3"
                  Height="16"
                  CornerRadius="1.5"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentFillColorDefaultBrush}"
                  Visibility="Hidden" />

                <Image
                  Width="32"
                  Height="32"
                  Margin="12,0,12,0"
                  Source="{Binding Icon}"
                  RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock
                    local:HighlightedTitle.Row="{Binding}"
                    FontSize="15"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock
                    Text="{Binding Subtitle}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding HasSubtitle, Converter={StaticResource Visible}}" />
                </StackPanel>

                <StackPanel
                  x:Name="Hint"
                  Grid.Column="2"
                  Orientation="Horizontal"
                  Margin="12,0,12,0"
                  Visibility="Collapsed">
                  <TextBlock
                    Text="{Binding ActionTitle}"
                    FontSize="12"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Border Style="{StaticResource KeycapStyle}">
                    <TextBlock
                      Text="{Binding ActionChord}"
                      FontSize="11"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock
        Text="{Binding Status}"
        FontSize="13"
        Margin="14,10,14,6"
        TextWrapping="Wrap"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />

    </StackPanel>
  </Border>
</Window>
