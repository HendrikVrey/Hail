<Window
  x:Class="Hail.App.SearchWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Hail.App"
  Title="Hail"
  Width="600"
  SizeToContent="Height"
  WindowStyle="SingleBorderWindow"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  Topmost="True"
  WindowStartupLocation="Manual"
  Left="-32000"
  Top="-32000"
  Background="Transparent"
  UseLayoutRounding="True"
  FontFamily="{StaticResource BoxFont}">

  <!--
    A normal window frame with no caption: DWM keeps drawing the frame's shadow, its rounded
    corners and, behind the transparent client area, the transient acrylic backdrop
    (Hail.md §10.2). WindowStyle="None" would lose all three.
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome
      CaptionHeight="0"
      GlassFrameThickness="-1"
      ResizeBorderThickness="0"
      CornerRadius="0"
      UseAeroCaptionButtons="False"
      NonClientFrameEdges="None" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>

  <Border x:Name="Surface" Padding="6,2,6,6">
    <StackPanel>

      <Grid Height="46" Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
          FontFamily="{StaticResource IconFont}"
          FontSize="16"
          Text="&#xE721;"
          VerticalAlignment="Center"
          Margin="2,1,12,0"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- The keyword in force: "g" shows Google, so the user sees the scope they are in. -->
        <Border
          x:Name="ScopeChip"
          Grid.Column="1"
          Style="{StaticResource ScopeChipStyle}"
          Visibility="{Binding HasScope, Converter={StaticResource Visible}}">
          <TextBlock
            Text="{Binding Scope}"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Border>

        <Grid Grid.Column="2">
          <TextBlock
            x:Name="Placeholder"
            Text="Search apps, files and the web, or type a sum"
            FontFamily="{StaticResource BoxDisplayFont}"
            FontSize="18"
            Margin="2,0,0,0"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis"
            IsHitTestVisible="False"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBox
            x:Name="SearchBox"
            Style="{StaticResource SearchBoxStyle}"
            AutomationProperties.Name="Search"
            TextChanged="SearchBox_TextChanged" />
        </Grid>
      </Grid>

      <Border
        Height="1"
        Margin="-6,0,-6,0"
        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
        Visibility="{Binding HasContent, Converter={StaticResource Visible}}" />

      <ItemsControl
        x:Name="Rows"
        Margin="0,4,0,0"
        ItemsSource="{Binding Rows}"
        Focusable="False"
        Visibility="{Binding HasRows, Converter={StaticResource Visible}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ResultRow}">
            <Border
              x:Name="Row"
              Height="38"
              CornerRadius="5"
              Background="Transparent"
              Cursor="Hand"
              MouseMove="Row_MouseMove"
              MouseLeftButtonUp="Row_MouseLeftButtonUp">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The Windows 11 selection mark: an accent pill at the row's left edge. -->
                <Border
                  x:Name="Pill"
                  Width="3"
                  Height="14"
                  CornerRadius="1.5"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentFillColorDefaultBrush}"
                  Visibility="Hidden" />

                <Grid Width="24" Height="24" Margin="10,0,10,0">
                  <Image
                    x:Name="IconImage"
                    Source="{Binding Icon}"
                    RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock
                    x:Name="IconGlyph"
                    Text="{Binding Glyph}"
                    FontFamily="{StaticResource IconFont}"
                    FontSize="17"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock
                    local:HighlightedTitle.Row="{Binding}"
                    FontSize="14"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                  <TextBlock
                    Text="{Binding Subtitle}"
                    FontSize="11"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding HasSubtitle, Converter={StaticResource Visible}}" />
                </StackPanel>

                <StackPanel
                  x:Name="Hint"
                  Grid.Column="2"
                  Orientation="Horizontal"
                  Margin="10,0,10,0"
                  Visibility="Collapsed">
                  <TextBlock
                    Text="{Binding ActionTitle}"
                    FontSize="12"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Border Style="{StaticResource KeycapStyle}">
                    <TextBlock
                      Text="{Binding ActionChord}"
                      FontSize="11"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HasGlyph}" Value="True">
                <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconGlyph" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IconMissing}" Value="True">
                <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="IconGlyph" Property="Visibility" Value="Visible" />
                <Setter TargetName="IconGlyph" Property="Text" Value="&#xE8A5;" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock
        Text="{Binding Status}"
        FontSize="12"
        Margin="12,8,12,4"
        TextWrapping="Wrap"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />

      <!-- The highlighted row's other actions, each with its chord: the keymap made findable. -->
      <ItemsControl
        x:Name="Footer"
        Margin="10,4,10,0"
        ItemsSource="{Binding Footer}"
        Focusable="False"
        Visibility="{Binding HasFooter, Converter={StaticResource Visible}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ActionHint}">
            <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
              <Border Style="{StaticResource KeycapStyle}">
                <TextBlock
                  Text="{Binding Chord}"
                  FontSize="11"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Border>
              <TextBlock
                Text="{Binding Title}"
                FontSize="12"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </Border>
</Window>
