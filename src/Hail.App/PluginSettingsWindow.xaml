<ui:FluentWindow
  x:Class="Hail.App.PluginSettingsWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="Hail: plugin settings"
  Width="520"
  MaxHeight="760"
  SizeToContent="Height"
  ResizeMode="NoResize"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
  FontFamily="{StaticResource BoxFont}"
  PreviewKeyDown="Window_PreviewKeyDown">

  <!--
    A plugin's settings, drawn from the declarations in its plugin.json (Hail.md §6.2): the
    rows are made in code, one per setting, so no plugin code runs to draw them.
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Title="Hail" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="28,4,28,8">
      <TextBlock
        x:Name="Heading"
        FontFamily="{StaticResource BoxDisplayFont}"
        FontSize="20"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        TextWrapping="Wrap" />
      <TextBlock
        x:Name="Subheading"
        Margin="0,2,0,0"
        FontSize="13"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Padding="28,4,28,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Fields" />
    </ScrollViewer>

    <StackPanel Grid.Row="3" Margin="28,12,28,24">
      <TextBlock
        x:Name="Problem"
        Margin="0,0,0,10"
        FontSize="13"
        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
        TextWrapping="Wrap"
        Visibility="Collapsed" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button
          MinWidth="96"
          Appearance="Primary"
          Click="Save_Click"
          Content="Save" />
        <ui:Button
          MinWidth="96"
          Margin="8,0,0,0"
          Click="Cancel_Click"
          Content="Cancel" />
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
