<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    The box's own styles. Every colour is a WPF-UI theme brush through DynamicResource, so the
    box follows Windows between light and dark without a palette of its own.

    The search field gets an explicit Style AND Template, not a BasedOn: WPF-UI's implicit
    TextBox style brings padding, a border and a focus underline, and a BasedOn would bring
    them back (Sling's find bar paid for that lesson).
  -->

  <FontFamily x:Key="BoxFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="BoxDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="SearchBoxStyle" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource BoxDisplayFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="AcceptsReturn" Value="False" />
    <Setter Property="AcceptsTab" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer
            x:Name="PART_ContentHost"
            Style="{x:Null}"
            Focusable="False"
            Padding="0"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden"
            VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScopeChipStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="Padding" Value="8,3,8,4" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="KeycapStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="Padding" Value="6,1,6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
