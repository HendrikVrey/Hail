<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure: the supervisor, keyword parsing, matching, ranking, history, the result list, the
    Windows Search SQL, and the ports first-party providers talk to the host through. No I/O, no interop, no process, no UI, and no PackageReference, which
    ArchitectureTests holds it to. That is what lets the code that decides what the user sees
    be tested exhaustively without a window.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hail.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hail.Sdk\Hail.Sdk.csproj" />
  </ItemGroup>

</Project>
